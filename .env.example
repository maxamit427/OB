# Runtime
NODE_ENV=production
PORT=5000
JWT_SECRET=replace-with-a-long-random-value
SESSION_SECRET=replace-with-a-long-random-value

# Persistent production storage
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/older-brother

# Google OAuth Web Client ID (public; alternatively use config/google/client-id.json)
GOOGLE_CLIENT_ID=1234567890-example.apps.googleusercontent.com

# OTP email delivery
GMAIL_USER=your-gmail@gmail.com
GMAIL_APP_PASSWORD=your-16-character-gmail-app-password
# Or use the configured Yahoo fallback:
# YAHOO_EMAIL_PASSWORD=your-yahoo-app-password